<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. Protect sensitive Laravel files and folders
    RewriteRule ^(\.env|\.git|composer\.(json|lock)|package\.(json|lock)|artisan) - [F,L,NC]
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests)/ - [F,L,NC]

    # 2. Route the homepage to public/index.php
    RewriteRule ^$ public/index.php [L]

    # 3. Route all other requests (CSS, JS, sub-pages) to public/
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>